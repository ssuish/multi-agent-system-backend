# --- Pydantic Settings (see docs/integrations.md) ---
DATABASE_URL=postgresql://user:pass@localhost:5432/dbname
CLERK_JWKS_URL=https://example.clerk.accounts.dev/.well-known/jwks.json
CLERK_ISSUER=https://example.clerk.accounts.dev
# CLERK_AUDIENCE=
CORS_ORIGINS=http://localhost:3000
MCP_ENABLED=false
# MCP_SERVER_COMMAND=["npx","-y","@modelcontextprotocol/server-everything"]

# --- A2A / deployment ---
APP_URL=http://127.0.0.1:8000
AGENT_VERSION=0.1.0

# --- Optional GCS / telemetry (bucket name without gs:// prefix) ---
# LOGS_BUCKET_NAME=my-project-logs
# OTEL_INSTRUMENTATION_GENAI_CAPTURE_MESSAGE_CONTENT=false
# GENAI_TELEMETRY_PATH=completions

# COMMIT_SHA and AGENT_VERSION are often set by Docker/Cloud Run; optional locally:
# COMMIT_SHA=dev
